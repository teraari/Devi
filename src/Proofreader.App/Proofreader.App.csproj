<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <AssemblyName>Devi</AssemblyName>
    <ApplicationIcon>Assets\devi.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.0.0" />
    
    <!-- ЭТИ ДВЕ СТРОКИ БЫЛИ ПОТЕРЯНЫ -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />

    <!-- Безопасные версии для подавления предупреждений -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.2" />

    <PackageReference Include="Avalonia.Diagnostics" Version="11.0.0">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proofreader.Application\Proofreader.Application.csproj" />
    <ProjectReference Include="..\Proofreader.Core\Proofreader.Core.csproj" />
    <ProjectReference Include="..\Proofreader.Infrastructure\Proofreader.Infrastructure.csproj" />
    <ProjectReference Include="..\Proofreader.Language\Proofreader.Language.csproj" />
  </ItemGroup>
</Project>