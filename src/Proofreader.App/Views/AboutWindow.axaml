<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Proofreader.App.ViewModels"
        x:Class="Proofreader.App.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Icon="/Assets/devi.ico"
        Title="Devi - О программе"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        CanResize="False">

    <Grid Margin="20" RowDefinitions="Auto, Auto, *, Auto">
        
        <!-- Иконка и название -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,20">
            <Image Source="/Assets/devi.png" Width="80" Height="80" Stretch="Uniform" />
            <TextBlock Text="Devi" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="Инструмент для проверки и редактирования документации" 
                       FontSize="12" 
                       Foreground="#888888" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center" />
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Fill="#3E3E42" Margin="0,10" />

        <!-- Информация о версии -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="100, *">
                <TextBlock Grid.Column="0" Text="Версия:" Foreground="#777777" />
                <TextBlock Grid.Column="1" Text="1.0.0 (MVP)" Foreground="#CCCCCC" />
            </Grid>
            <Grid ColumnDefinitions="100, *">
                <TextBlock Grid.Column="0" Text=".NET:" Foreground="#777777" />
                <TextBlock Grid.Column="1" Text="10.0" Foreground="#CCCCCC" />
            </Grid>
            <Grid ColumnDefinitions="100, *">
                <TextBlock Grid.Column="0" Text="ОС:" Foreground="#777777" />
                <TextBlock Grid.Column="1" Text="Microsoft Windows" Foreground="#CCCCCC" />
            </Grid>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,0">
            <!-- Теперь кнопки активны и имеют обработчики -->
            <Button Content="GitHub" Background="#333333" Foreground="#CCCCCC" Padding="15,6" Click="OnGitHubClick" />
            <Button Content="Лицензия" Background="#333333" Foreground="#CCCCCC" Padding="15,6" Click="OnLicenseClick" />
            <Button Content="Закрыть" Background="#007ACC" Foreground="White" Padding="20,6" Click="OnCloseClick" />
        </StackPanel>

    </Grid>
</Window>